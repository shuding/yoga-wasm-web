{
  "name": "yoga-wasm-web",
  "version": "0.3.3",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./yoga_generated/*": "./dist/yoga_generated/yoga.wasm",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "imports": {
    "#yoga/*": "./yoga/javascript/src/*"
  },
  "scripts": {
    "build-yoga": "make",
    "build": "bunchee",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir ./test"
  },
  "repository": "shuding/yoga-wasm-web",
  "license": "MIT",
  "files": [
    "dist",
    "package.json",
    "LICENSE"
  ],
  "devDependencies": {
    "bunchee": "^6.6.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}