{
  "name": "yoga-wasm-web",
  "version": "0.3.3",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./yoga.wasm": "./dist/yoga_generated/yoga.wasm",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build-yoga": "make",
    "build": "vite build",
    "clean": "rm -rf dist",
