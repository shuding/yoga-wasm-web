  },
  "repository": "shuding/yoga-wasm-web",
  "license": "MIT",
  "files": [
    "dist",
    "package.json",
    "LICENSE"
  ],
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vite-plugin-dts": "^4.2.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "yoga-layout": "3.2.1"
  }
}