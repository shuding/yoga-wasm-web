{
  "compilerOptions": {
    "esModuleInterop": true,
    "moduleResolution": "node",
    "module": "ES2022",
    "target": "ES2022",
    "strict": true,

    "noEmit": true,
    "allowImportingTsExtensions": true,

    "baseUrl": ".",
    "paths": {
      "#yoga/*": ["./yoga/javascript/src/*"],
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}